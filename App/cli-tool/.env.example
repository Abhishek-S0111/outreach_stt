# Report Generation Pipeline - Environment Configuration

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Zoho WorkDrive API
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ROOT_FOLDER_ID=i672ed6de805500cf4a1fb757653eb2968d65

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=outreach_reports

# File Storage
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=500

# Transcription Settings
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
# Options: cpu, cuda (if GPU available)

# Translation Settings
TRANSLATION_MODEL=ai4bharat/indictrans2-en-indic-1B
# Supports all Indian languages

# LLM Settings
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/pipeline.log

# Processing
MAX_CONCURRENT_JOBS=3
TASK_TIMEOUT_MINUTES=30
